{
  "name": "fraud-feature-pipeline",
  "description": "Daily: bronze -> silver point-in-time features (Delta) -> OPTIMIZE/ZORDER",
  "schedule": {
    "quartz_cron_expression": "0 0 3 * * ?",
    "timezone_id": "America/Chicago",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "email_notifications": { "on_failure": ["rabeyasiddiqui@gmail.com"] },
  "tasks": [
    {
      "task_key": "build_features",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/rabeyasiddiqui@gmail.com/fraud-feature-pipeline/build_features_notebook",
        "base_parameters": {
          "raw_path": "/FileStore/fraud/raw/transactions",
          "merchants_path": "/FileStore/fraud/raw/merchants.parquet",
          "schema": "fraud",
          "hist_end": "2026-02-01",
          "label_cutoff": "2026-03-21"
        }
      },
      "job_cluster_key": "small_cluster",
      "timeout_seconds": 3600,
      "max_retries": 2,
      "min_retry_interval_millis": 300000
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "small_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 2,
        "spark_conf": {
          "spark.sql.shuffle.partitions": "64",
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        }
      }
    }
  ]
}
